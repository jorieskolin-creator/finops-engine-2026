# Copy to .env.local for `vercel dev`, or export these variables before running
# the Node server directly. Configure the same secrets in the deployment platform.
# Never commit populated environment files.

# Auth: doubles as the shared login password AND HMAC signing key for the
# session cookie. Rotating it invalidates all active sessions.
SECRET_KEY=

# Active LLM providers (server-side only — never exposed to the browser).
# GPT_API_KEY is accepted as an alternative name for OPENAI_API_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=

# Optional server-side provider routing. If PRIMARY_MODEL_PROVIDER is omitted,
# the established mixed-provider route remains active. Allowed values are
# ANTHROPIC, OPENAI, or QWEN; fallback also accepts NONE.
# PRIMARY_MODEL_PROVIDER=QWEN
# FALLBACK_MODEL_PROVIDER=OPENAI

# Required by the long-lived Railway server. PostgreSQL is the content-free
# authoritative control plane; Redis holds deadline-bounded transient content.
DATABASE_URL=
REDIS_URL=

# Optional: public URL for remote FinOps tactics database (exposed to client,
# must keep the VITE_ prefix).
VITE_FINOPS_TACTICS_URL=

# Optional: remote reference Knowledge Base stored in Vercel Blob.
BLOB_READ_WRITE_TOKEN=
FINOPS_KB_BLOB_PREFIX=Knowledge Base/

# Server port — Railway and similar hosts set this automatically.
PORT=3000
