{
  "version": "1.0.0",
  "description": "Canonical FinOps Engine taxonomy. Use these domain, capability, stream, and evidence-category indexes for Knowledge Base documents and assessment outputs. Reference KB material may guide scoring and recommendations, but must not be treated as customer source evidence.",
  "domains": [
    {
      "id": "A",
      "name": "Cost Visibility & Allocation",
      "capabilities": ["A1", "A2", "A3", "A4", "A5"]
    },
    {
      "id": "B",
      "name": "Rate & Usage Optimization",
      "capabilities": ["B1", "B2", "B3", "B4", "B5"]
    },
    {
      "id": "C",
      "name": "Governance & Policy",
      "capabilities": ["C1", "C2", "C3", "C4", "C5"]
    },
    {
      "id": "D",
      "name": "Architecture & Engineering",
      "capabilities": ["D1", "D2", "D3", "D4", "D5"]
    },
    {
      "id": "E",
      "name": "Culture & Organization",
      "capabilities": ["E1", "E2", "E3", "E4", "E5"]
    },
    {
      "id": "F",
      "name": "GenAI & AI Cost Management",
      "capabilities": ["F1", "F2", "F3", "F4", "F5"]
    }
  ],
  "streams": ["maturity", "antipattern"],
  "evidence_categories": [
    "Policy",
    "Process",
    "Operational",
    "Automation",
    "Accountability",
    "Financial-Integration",
    "Cultural"
  ],
  "kb_document_naming": {
    "pattern": "<Domain ID> - <Domain Name> - <Criterion ID (A1..F5 | AP-A1..AP-F5)> - <Canonical Criterion Title>.pdf",
    "expected_document_count": 60,
    "examples": [
      "Knowledge Base/Cost Visibility & Allocation/A - Cost Visibility & Allocation - A1 - Comprehensive Cost Allocation & Tagging.pdf",
      "Knowledge Base/Cost Visibility & Allocation/A - Cost Visibility & Allocation - AP-A1 - Tag Sprawl & Missing Tags.pdf",
      "Knowledge Base/Governance & Policy/C - Governance & Policy - C1 - Cloud Financial Policy Framework.pdf",
      "Knowledge Base/GenAI & AI Cost Management/F - GenAI & AI Cost Management - F2 - AI Cost Allocation & Unit Economics.pdf"
    ],
    "required_front_matter": {
      "required_fields": [
        "kb_type",
        "domain_id",
        "domain_name",
        "stream",
        "criterion_id",
        "capability_id",
        "evidence_categories",
        "allowed_uses",
        "forbidden_uses",
        "version"
      ],
      "forbidden_uses": ["customer_current_state_claim", "source_evidence_quote"]
    },
    "required_sections_by_stage": {
      "forensic_audit": [
        "canonical_definition",
        "evidence_requirements",
        "false_positive_guards",
        "validation_questions",
        "scoring_guidance"
      ],
      "evidence_check": [
        "canonical_definition",
        "evidence_requirements",
        "false_positive_guards",
        "validation_questions"
      ],
      "synthesis": [
        "canonical_definition",
        "evidence_requirements",
        "false_positive_guards"
      ],
      "roadmap_synthesis": [
        "canonical_definition",
        "risk_notes",
        "remediation_tactic_notes"
      ]
    }
  },
  "usage_boundaries": {
    "reference_kb_allowed_uses": [
      "rubric_context",
      "maturity_examples",
      "antipattern_examples",
      "evidence_requirements",
      "validation_questions",
      "tactic_selection",
      "remediation_patterns",
      "risk_notes"
    ],
    "reference_kb_forbidden_uses": [
      "customer_current_state_claim",
      "source_evidence_quote",
      "audited_finding",
      "phase1_evidence_quote"
    ]
  }
}
